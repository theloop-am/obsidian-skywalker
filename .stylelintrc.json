{
  "$schema": "https://json.schemastore.org/stylelintrc.json",
  "plugins": ["stylelint-no-unsupported-browser-features"],
  "reportDescriptionlessDisables": true,
  "reportInvalidScopeDisables": true,
  "reportNeedlessDisables": true,
  "reportUnscopedDisables": true,
  "rules": {
    "function-url-scheme-disallowed-list": [["http", "https", "file"]],
    "function-url-scheme-allowed-list": ["data"],
    "declaration-no-important": true,
    "color-named": "never",
    "custom-property-no-missing-var-function": null,
    "no-duplicate-selectors": null,
    "no-duplicate-at-import-rules": null,
    "declaration-block-no-duplicate-properties": true,
    "shorthand-property-no-redundant-values": null,
    "plugin/no-unsupported-browser-features": [
      true,
      {
        "browsers": ["electron >= 39"],
        "ignore": [
          "css-nesting",
          "css-cascade-layers",
          "css-clip-path",
          "css-text-indent",
          "multicolumn",
          "text-decoration"
        ]
      }
    ],
    "selector-pseudo-class-no-unknown": [true, { "ignorePseudoClasses": ["global", "local"] }],
    "selector-pseudo-element-no-unknown": true,
    "selector-type-no-unknown": [true, { "ignoreTypes": [] }],
    "at-rule-no-unknown": [true, { "ignoreAtRules": ["layer", "property", "container"] }],
    "unit-no-unknown": true,
    "property-disallowed-list": ["all"],
    "declaration-property-value-no-unknown": true,
    "function-no-unknown": true,
    "property-no-unknown": true,
    "no-unknown-animations": true
  }
}
